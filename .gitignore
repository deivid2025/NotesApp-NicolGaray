# ── Build de Next.js ──────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts

# ── Producción / standalone ───────────────────────────────
/.next-standalone/
/server.js

# ── Depuración y logs ─────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log
logs/
mini-services/*/watchdog.log
mini-services/*/*.log

# ── Variables de entorno ──────────────────────────────────
.env
.env*.local
.env.development
.env.production
!.env.example

# ── Base de datos (SQLite local) ──────────────────────────
*.db
*.db-journal
/prisma/dev.db
/prisma/*.db
/prisma/migrations/dev/

