.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# ── Caché de TypeScript ───────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Vercel ────────────────────────────────────────────────
.vercel

# ── Docker (volúmenes locales) ────────────────────────────
docker-data/

# ── Capturas y temporales de QA ───────────────────────────
upload/qa-*.png
upload/pasted_image_*.png
/tmp/

# ── Mini-services (solo mantener código fuente, no runtime) ─
mini-services/*/node_modules/

# ── Archivos del sandbox / tooling interno (NO son parte de la app) ──
# Skills de Z.ai (definiciones internas, no del proyecto)
/skills/
# Capturas y descargas antiguas de QA
/download/
# Ejemplos internos (demo de websocket, etc.)
/examples/
# Scripts de build de runtime del sandbox
/tests/
# Resultados internos de herramientas
/tool-results/
# Contexto interno de agentes
/agent-ctx/
# Capturas de pantalla de QA
/upload/
# Mini-services del sandbox (watchdog del dev server)
/mini-services/
# Scripts y configuración del sandbox
/start-dev.sh
/Caddyfile
# Worklog interno de desarrollo (se mantiene local para el cron, no va a GitHub)
/worklog.md
.zscripts/
