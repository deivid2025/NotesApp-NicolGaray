# ── TaskBoard Environment Variables ──────────────────────────────────────
# Copy this file to `.env` and adjust as needed.
# Do NOT commit real credentials to the repository.

# Port the app listens on inside the container (default 3000)
PORT=3000

# Node environment
NODE_ENV=production

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ── GitHub deploy (local-only, NEVER committed) ─────────────────────────
# Used by the deploy script to push the app to GitHub.
# Token scope: repo (contents read/write).
# IMPORTANT: regenerate this token after the deploy if you shared it in chat.
GITHUB_TOKEN=
GITHUB_REPO=
